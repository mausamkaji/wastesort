# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Optional, free fallback AI provider (build.nvidia.com NIM API).
# Used automatically when GEMINI_API_KEY is not set, or when Gemini's quota is exhausted.
# Get a free key at https://build.nvidia.com (sign in, open any model, "Get API Key").
NVIDIA_API_KEY="nvapi-MY_NVIDIA_API_KEY"

# ANTHROPIC_API_KEY: Optional, third-tier fallback (only used if both Gemini and NVIDIA fail).
# Paid, but far more reliable at returning well-formed JSON than the free NVIDIA model.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
